{
  "name": "Tour",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "band_members": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of characters in the band"
    },
    "manager_id": {
      "type": "string",
      "description": "ID of the manager character"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "color": {
      "type": "string",
      "default": "#ef4444"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "name"
  ]
}